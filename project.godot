config_version=5

[application]

config/name="Escape From Monster"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Compatibility")

[input_devices/pointing]

emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=5
